# ---------------------------------------------------------------------------
# AgentGuard — local development environment
# Copy to `.env` and adjust. `.env` is git-ignored.
#
# Host ports use an AgentGuard-specific block so the stack can run alongside
# other local Postgres/Redis/Qdrant instances without collisions.
# ---------------------------------------------------------------------------

# --- Core ---
AGENTGUARD_ENV=development
AGENTGUARD_LOG_LEVEL=INFO
# Secret used to sign local tokens. Generate a real one: `openssl rand -hex 32`
AGENTGUARD_SECRET_KEY=dev-only-insecure-change-me-0000000000000000

# --- Host port mapping (change only if these collide on your machine) ---
POSTGRES_PORT=5442
REDIS_PORT=6389
KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=19644
CLICKHOUSE_HTTP_PORT=8124
CLICKHOUSE_NATIVE_PORT=9011
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
API_PORT=8010
WEB_PORT=3010

# --- PostgreSQL (core transactional DB) ---
POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=agentguard
# SQLAlchemy async URL — host + POSTGRES_PORT above
DATABASE_URL=postgresql+asyncpg://agentguard:agentguard@localhost:5442/agentguard

# --- Redis (cache, rate limiting, session + approval state) ---
REDIS_URL=redis://localhost:6389/0

# --- Redpanda / Kafka (runtime event stream) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- ClickHouse (high-volume event storage + analytics) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124
CLICKHOUSE_DB=agentguard_events
CLICKHOUSE_USER=agentguard
CLICKHOUSE_PASSWORD=agentguard

# --- Qdrant (threat-intel / attack-pattern vectors) ---
QDRANT_URL=http://localhost:6343

# --- MinIO (S3-compatible object storage) ---
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=agentguard
S3_SECRET_KEY=agentguard-secret
S3_BUCKET=agentguard-artifacts
S3_REGION=us-east-1

# --- Web dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
