<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AgentGuard.Cli</AssemblyName>
    <RootNamespace>AgentGuard.Cli</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentguard</ToolCommandName>
    <PackageId>AgentGuard.NET.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentGuard/AgentGuard.csproj" />
  </ItemGroup>

</Project>
